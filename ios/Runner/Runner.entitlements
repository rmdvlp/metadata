<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for APNs. Without this entitlement iOS issues no device
	     token at all, so FirebaseMessaging.getToken() never resolves and the
	     PushKit registry never produces a VoIP token — i.e. no push
	     notifications and no incoming calls, with no visible error.
	     "development" is correct for debug/TestFlight builds; Xcode rewrites
	     it to "production" automatically when exporting for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
