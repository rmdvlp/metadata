# Copy to functions/.env.metadata-64577 (per-project) or functions/.env (all projects).
# These are NON-SECRET deploy-time params. The APNs .p8 private key is NOT here —
# it lives in Secret Manager as APNS_AUTH_KEY (see README.md).
#
# .env.metadata-64577 is safe to commit; .env.local / *.local are gitignored.

# 10-character Key ID of the APNs auth key (Apple Developer > Keys)
APNS_KEY_ID=

# 10-character Apple Developer Team ID (Apple Developer > Membership)
APNS_TEAM_ID=

# iOS bundle identifier. The PushKit topic is "<bundle id>.voip".
APNS_BUNDLE_ID=com.example.metadata

# false -> api.sandbox.push.apple.com (debug builds from Xcode)
# true  -> api.push.apple.com (TestFlight / App Store builds)
APNS_PRODUCTION=false
