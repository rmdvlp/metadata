# Firebase Web App config for project metadata-64577.
#
# These come from: Firebase console -> Project settings -> General ->
# "Your apps" -> Web app -> SDK setup and configuration -> Config.
# If no Web app exists yet, click "Add app" -> Web (</>) first.
#
# Copy this file to `.env.local` and fill in the two values marked TODO.
# Everything a Vite client can read is public by design — these are not
# secrets, access is controlled by firestore.rules and the admins/{uid} doc.

VITE_FIREBASE_API_KEY=TODO_web_api_key
VITE_FIREBASE_APP_ID=TODO_web_app_id
VITE_FIREBASE_AUTH_DOMAIN=metadata-64577.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=metadata-64577
VITE_FIREBASE_STORAGE_BUCKET=metadata-64577.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=823490823169

# Optional: point the app at the local Firebase emulator suite instead of prod.
# VITE_USE_FIREBASE_EMULATOR=true
